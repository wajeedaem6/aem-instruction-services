<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="nt:unstructured"
    jcr:title="Properties"
    sling:resourceType="cq/gui/components/authoring/dialog">
    <content
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns">
        <items jcr:primaryType="nt:unstructured">
            <column
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/container">
                <items jcr:primaryType="nt:unstructured">
                    <fullName
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                            fieldLabel="Full Name"
                            fieldDescription="Enter your full name"
                            name="./fullName"
                            emptyText="Enter full name"
                            required="{Boolean}true"/>

                    <div class="details-field">
                        <label>Father Name:</label>
                        <span>${properties.fatherName}</span>
                    </div>
                    <qualification
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                            fieldLabel="Highest Qualification"
                            name="./qualification"
                            emptyText="Enter qualification"/>
                    <occupation
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                            fieldLabel="Occupation"
                            name="./occupation"
                            emptyText="Enter occupation"/>
                    <age
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                            fieldLabel="Age"
                            name="./age"
                            required="{Boolean}true"/>
                    <height
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                            fieldLabel="Height"
                            name="./height"
                            required="{Boolean}true"/>
                    <complexion
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/form/select"
                            fieldLabel="Complexion"
                            name="./complexion"
                            required="{Boolean}true">
                        <items jcr:primaryType="nt:unstructured">
                            <fair
                                    jcr:primaryType="nt:unstructured"
                                    text="Fair"
                                    value="Fair"/>
                            <medium
                                    jcr:primaryType="nt:unstructured"
                                    text="Medium"
                                    value="Medium"/>
                            <dark
                                    jcr:primaryType="nt:unstructured"
                                    text="Dark"
                                    value="Dark"/>
                        </items>
                    </complexion>
                    <religion
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/form/select"
                            fieldLabel="Religion"
                            name="./religion">
                        <items jcr:primaryType="nt:unstructured">
                            <hindu
                                    jcr:primaryType="nt:unstructured"
                                    text="Hindu"
                                    value="Hindu"/>
                            <muslim
                                    jcr:primaryType="nt:unstructured"
                                    text="Muslim"
                                    value="Muslim"/>
                            <christian
                                    jcr:primaryType="nt:unstructured"
                                    text="Christian"
                                    value="Christian"/>
                            <sikh
                                    jcr:primaryType="nt:unstructured"
                                    text="Sikh"
                                    value="Sikh"/>
                            <buddhist
                                    jcr:primaryType="nt:unstructured"
                                    text="Buddhist"
                                    value="Buddhist"/>
                            <jain
                                    jcr:primaryType="nt:unstructured"
                                    text="Jain"
                                    value="Jain"/>
                            <other
                                    jcr:primaryType="nt:unstructured"
                                    text="Other"
                                    value="Other"/>
                            <preferNotToSay
                                    jcr:primaryType="nt:unstructured"
                                    text="Prefer not to say"
                                    value="Prefer not to say"/>
                        </items>
                    </religion>
                    <grandFatherName
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                            fieldLabel="Grandfather Name"
                            name="./grandFatherName"
                            required="{Boolean}false"/>
                    <brother
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/form/textarea"
                            fieldLabel="brother"
                            name="./text"
                            rows="5"
                            required="{Boolean}false"/>
                    <sisterName
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                            fieldLabel="Sister Name"
                            name="./sisterName"
                            required="{Boolean}false"/>
                    <brotherInLawName
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                            fieldLabel="Brother-in-Law Name"
                            name="./brotherInLawName"
                            required="{Boolean}false"/>
                    <address
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/form/textarea"
                            fieldLabel="Address"
                            name="./address"
                            rows="4"
                            required="{Boolean}false"/>
                    <mobileNumber
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                            fieldLabel="Mobile Number"
                            name="./mobileNumber"/>

                </items>
            </column>
        </items>
    </content>
</jcr:root>