<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
          xmlns:granite="http://www.adobe.com/jcr/granite/1.0"
          xmlns:cq="http://www.day.com/jcr/cq/1.0"
          xmlns:jcr="http://www.jcp.org/jcr/1.0"
          xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
          jcr:primaryType="nt:unstructured"
          jcr:title="Custom Carousel"
          sling:resourceType="cq/gui/components/authoring/dialog"
          helpPath="https://helpx.adobe.com/support/experience-manager/6-5.html">
    <content
            jcr:primaryType="nt:unstructured"
            sling:resourceType="granite/ui/components/coral/foundation/container">
        <items jcr:primaryType="nt:unstructured">
            <tabs
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="granite/ui/components/coral/foundation/tabs"
                    maximized="{Boolean}true">
                <items jcr:primaryType="nt:unstructured">
                    <items
                            jcr:primaryType="nt:unstructured"
                            jcr:title="Properties"
                            sling:resourceType="granite/ui/components/coral/foundation/container"
                            margin="{Boolean}true">
                        <items jcr:primaryType="nt:unstructured">
                            <columns
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns"
                                    margin="{Boolean}true">
                                <items jcr:primaryType="nt:unstructured">
                                    <column
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="granite/ui/components/coral/foundation/container">
                                        <items jcr:primaryType="nt:unstructured">

                                            <multifield jcr:primaryType="nt:unstructured"
                                                        sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                                                        fieldLabel="carousel"
                                                        composite="{Boolean}true">
                                                <field sling:resourceType="granite/ui/components/coral/foundation/container"
                                                       jcr:primaryType="nt:unstructured"
                                                       name="./carouselItems">
                                                    <items jcr:primaryType="nt:unstructured">
                                                        <asset jcr:primaryType="nt:unstructured"
                                                               sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                                               fieldLabel="asset"
                                                               name="./asset"
                                                               required="{Boolean}true"
                                                               rootPath="/content/dam/"/>
                                                        <text jcr:primaryType="nt:unstructured"
                                                              sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                              fieldLabel="Text"
                                                              required="{Boolean}true"
                                                              name="./text"/>
                                                        <heroText jcr:primaryType="nt:unstructured"
                                                                  sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                                  fieldLabel="Text"
                                                                  required="{Boolean}true"
                                                                  name="./heroText"/>
                                                        <cta jcr:primaryType="nt:unstructured"
                                                             sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                                             fieldLabel="Button"
                                                             name="./cta"
                                                             required="{Boolean}true"
                                                             rootPath="/content"/>
                                                        <ctaText jcr:primaryType="nt:unstructured"
                                                                 sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                                 fieldLabel="Alternative Text"
                                                                 required="{Boolean}true"
                                                                 name="./ctaText"/>
                                                        <heroText jcr:primaryType="nt:unstructured"
                                                                  sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                                  fieldLabel="HText"
                                                                  required="{Boolean}true"
                                                                  name="./heroText"/>
                                                        <altText jcr:primaryType="nt:unstructured"
                                                                 sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                                 fieldLabel="Alternative Text"
                                                                 required="{Boolean}false"
                                                                 name="./altText"/>
                                                    </items>
                                                </field>
                                            </multifield>
                                        </items>
                                    </column>
                                </items>
                            </columns>
                        </items>
                    </items>
                </items>
            </tabs>
        </items>
    </content>
</jcr:root>