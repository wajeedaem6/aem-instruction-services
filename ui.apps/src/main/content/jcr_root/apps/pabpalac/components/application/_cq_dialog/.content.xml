<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="nt:unstructured"
    jcr:title="Properties"
    sling:resourceType="cq/gui/components/authoring/dialog">
    <content
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns">
        <items jcr:primaryType="nt:unstructured">
            <column
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/container">
                <items jcr:primaryType="nt:unstructured">
                    <generalQuestions
                            jcr:primaryType="nt:unstructured"
                            jcr:title="General Questions"
                            sling:resourceType="granite/ui/components/coral/foundation/form/fieldset">

                        <items jcr:primaryType="nt:unstructured">

                            <proposedInsuredName
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                    fieldLabel="Proposed Insured's Name : "
                                    name="./proposedInsuredName"/>

                            <birthDate
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/datepicker"
                                    fieldLabel="Birth Date"
                                    name="./birthDate"/>

                            <gender
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/select"
                                    fieldLabel="Gender"
                                    name="./gender">

                                <items jcr:primaryType="nt:unstructured">

                                    <male
                                            jcr:primaryType="nt:unstructured"
                                            text="Male"
                                            value="male"/>

                                    <female
                                            jcr:primaryType="nt:unstructured"
                                            text="Female"
                                            value="female"/>

                                </items>
                            </gender>

                            <passportNo
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                    fieldLabel="Passport No"
                                    name="./passportNo"/>

                            <address
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/textarea"
                                    fieldLabel="Address"
                                    name="./address"/>

                            <phoneNumber
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                    fieldLabel="Phone Number"
                                    name="./phoneNumber"/>

                            <emailAddress
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                    fieldLabel="Email Address"
                                    name="./emailAddress"/>

                            <idNumber
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                    fieldLabel="ID Number"
                                    name="./idNumber"/>

                            <socialSecurityNumber
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                    fieldLabel="Social Security Number"
                                    name="./socialSecurityNumber"/>

                            <status
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/select"
                                    fieldLabel="Status"
                                    name="./status">

                                <items jcr:primaryType="nt:unstructured">

                                    <single
                                            jcr:primaryType="nt:unstructured"
                                            text="Single"
                                            value="single"/>

                                    <married
                                            jcr:primaryType="nt:unstructured"
                                            text="Married"
                                            value="married"/>

                                    <divorced
                                            jcr:primaryType="nt:unstructured"
                                            text="Divorced"
                                            value="divorced"/>

                                    <others
                                            jcr:primaryType="nt:unstructured"
                                            text="Others"
                                            value="others"/>

                                </items>
                            </status>

                            <occupation
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                    fieldLabel="Occupation"
                                    name="./occupation"/>

                            <retired
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
                                    text="Are you a retiree?"
                                    name="./retired"
                                    value="{Boolean}true"
                                    uncheckedValue="{Boolean}false"/>

                        </items>
                    </generalQuestions>


                    <!-- Personal Details -->

                    <personalDetails
                            jcr:primaryType="nt:unstructured"
                            jcr:title="Personal Details"
                            sling:resourceType="granite/ui/components/coral/foundation/form/fieldset">

                        <items jcr:primaryType="nt:unstructured">

                            <beneficiaryName
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                    fieldLabel="Name of Beneficiary"
                                    name="./beneficiaryName"/>

                            <bankAccount
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                    fieldLabel="Bank Account"
                                    name="./bankAccount"/>

                            <beneficiaryBankAddress
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/textarea"
                                    fieldLabel="Name and Address of Beneficiary's Bank"
                                    name="./beneficiaryBankAddress"/>

                        </items>
                    </personalDetails>


                    <!-- Plan Choice -->

                    <planChoice
                            jcr:primaryType="nt:unstructured"
                            jcr:title="Plan Choice"
                            sling:resourceType="granite/ui/components/coral/foundation/form/fieldset">

                        <items jcr:primaryType="nt:unstructured">

                            <employeePlan
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/select"
                                    fieldLabel="Employee Plan Choice"
                                    name="./employeePlan">

                                <items jcr:primaryType="nt:unstructured">

                                    <yes
                                            jcr:primaryType="nt:unstructured"
                                            text="Yes"
                                            value="yes"/>

                                    <no
                                            jcr:primaryType="nt:unstructured"
                                            text="No"
                                            value="no"/>

                                </items>
                            </employeePlan>

                            <spousePlan
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/select"
                                    fieldLabel="Spouse Plan Choice"
                                    name="./spousePlan">

                                <items jcr:primaryType="nt:unstructured">

                                    <yes
                                            jcr:primaryType="nt:unstructured"
                                            text="Yes"
                                            value="yes"/>

                                    <no
                                            jcr:primaryType="nt:unstructured"
                                            text="No"
                                            value="no"/>

                                </items>
                            </spousePlan>

                            <childrenPlan
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/select"
                                    fieldLabel="Children Plan Choice"
                                    name="./childrenPlan">

                                <items jcr:primaryType="nt:unstructured">

                                    <yes
                                            jcr:primaryType="nt:unstructured"
                                            text="Yes"
                                            value="yes"/>

                                    <no
                                            jcr:primaryType="nt:unstructured"
                                            text="No"
                                            value="no"/>

                                </items>
                            </childrenPlan>

                            <selectedPlan
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/select"
                                    fieldLabel="Plan"
                                    name="./selectedPlan">

                                <items jcr:primaryType="nt:unstructured">

                                    <planA
                                            jcr:primaryType="nt:unstructured"
                                            text="Plan A"
                                            value="planA"/>

                                    <planB
                                            jcr:primaryType="nt:unstructured"
                                            text="Plan B"
                                            value="planB"/>

                                </items>
                            </selectedPlan>

                            <planADescription
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/textarea"
                                    fieldLabel="Plan A Description"
                                    name="./planADescription"/>

                            <planBDescription
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/textarea"
                                    fieldLabel="Plan B Description"
                                    name="./planBDescription"/>

                        </items>
                    </planChoice>


                    <!-- Policy -->

                    <policy
                            jcr:primaryType="nt:unstructured"
                            jcr:title="The Policy"
                            sling:resourceType="granite/ui/components/coral/foundation/form/fieldset">

                        <items jcr:primaryType="nt:unstructured">

                            <units
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/numberfield"
                                    fieldLabel="Units"
                                    name="./units"/>

                            <annualPremium
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/numberfield"
                                    fieldLabel="Annual Premium"
                                    name="./annualPremium"/>

                            <paymentMode
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/select"
                                    fieldLabel="Payment Mode"
                                    name="./paymentMode">

                                <items jcr:primaryType="nt:unstructured">

                                    <annual
                                            jcr:primaryType="nt:unstructured"
                                            text="Annual"
                                            value="annual"/>

                                    <semiAnnual
                                            jcr:primaryType="nt:unstructured"
                                            text="Semi-Annual"
                                            value="semiAnnual"/>

                                    <monthlyPAT
                                            jcr:primaryType="nt:unstructured"
                                            text="Monthly PAT"
                                            value="monthlyPAT"/>

                                </items>
                            </paymentMode>

                            <cashWithApplication
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/numberfield"
                                    fieldLabel="Cash with Application"
                                    name="./cashWithApplication"/>

                            <plannedModalPremium
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/numberfield"
                                    fieldLabel="Planned Modal Premium"
                                    name="./plannedModalPremium"/>

                        </items>
                    </policy>


                    <!-- Terms and Conditions -->

                    <terms
                            jcr:primaryType="nt:unstructured"
                            jcr:title="Terms &amp; Conditions"
                            sling:resourceType="granite/ui/components/coral/foundation/form/fieldset">

                        <items jcr:primaryType="nt:unstructured">

                            <termsAndConditions
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/textarea"
                                    fieldLabel="Terms &amp; Conditions"
                                    name="./termsAndConditions"/>

                            <signature
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                    fieldLabel="Signature"
                                    name="./signature"/>

                            <date
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/datepicker"
                                    fieldLabel="Date"
                                    name="./date"/>

                        </items>
                    </terms>
                   </items>
            </column>
        </items>
    </content>
</jcr:root>